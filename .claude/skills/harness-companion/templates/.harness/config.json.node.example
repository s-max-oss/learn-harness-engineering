{
  "schema_version": 1,
  "project_type": "node",
  "verification": {
    "min_required_for_passing": ["typecheck", "test"],
    "commands": [
      {
        "id": "typecheck",
        "command": ["node", "-e", "process.exit(0)"],
        "timeout_seconds": 180,
        "required_for_passing": true,
        "applies_when": { "files_any": ["package.json"] }
      },
      {
        "id": "build",
        "command": ["node", "-e", "console.log('build ok')"],
        "timeout_seconds": 600,
        "required_for_passing": false,
        "applies_when": { "files_any": ["package.json"] }
      },
      {
        "id": "test",
        "command": ["node", "-e", "console.log('test ok')"],
        "timeout_seconds": 600,
        "required_for_passing": true,
        "applies_when": { "files_any": ["package.json"] }
      }
    ]
  },
  "feature_list": {
    "wip_limit": 1,
    "allow_force": true,
    "force_requires": { "reason": true, "actor": true, "timestamp": true }
  }
}