{
  "schema_version": 1,
  "project_type": "node",
  "verification": {
    "min_required_for_passing": ["typecheck", "test"],
    "commands": [
      {
        "id": "typecheck",
        "command": ["npm", "run", "check"],
        "timeout_seconds": 180,
        "required_for_passing": true,
        "applies_when": { "package_json_has_script": "check" }
      },
      {
        "id": "build",
        "command": ["npm", "run", "build"],
        "timeout_seconds": 600,
        "required_for_passing": false,
        "applies_when": { "package_json_has_script": "build" }
      },
      {
        "id": "test",
        "command": ["npm", "test"],
        "timeout_seconds": 600,
        "required_for_passing": true,
        "applies_when": { "package_json_has_script": "test" }
      }
    ]
  },
  "feature_list": {
    "wip_limit": 1,
    "allow_force": true,
    "force_requires": { "reason": true, "actor": true, "timestamp": true }
  }
}